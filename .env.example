# ── Application ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example

# ── Database (Coolify Postgres service — NOT a Compose service) ──────
# Use the internal hostname Coolify assigns to the Postgres service.
DATABASE_URL=postgresql://league:CHANGE_ME_STRONG_RANDOM_PASSWORD@YOUR_COOLIFY_PG_HOST:5432/league_management?schema=public

# ── Session (generate with: openssl rand -base64 48) ─────────────────
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_RANDOM_STRING
COOKIE_SECURE=true

# ── Primary admin bootstrap (first start only; not reset on restart) ─
PRIMARY_ADMIN_USERNAME=admin
PRIMARY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PRIMARY_ADMIN_PHONE=2348000000000

# ── RunPod OpenAI-compatible LLM (optional) ──────────────────────────
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1500
AI_ENABLED=false
AI_AUTO_PUBLISH=false

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# Set to true ONCE to reset primary admin password from PRIMARY_ADMIN_* env, then remove
FORCE_PRIMARY_ADMIN_RESET=false
