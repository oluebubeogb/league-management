generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Platform-level roles (super-admin) ──────────────────────────────
enum Role {
  FAN
  ADMIN
  PRIMARY_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ── League-level roles ──────────────────────────────────────────────
enum LeagueRole {
  OWNER
  ADMIN
  COACH
  FAN
  REFEREE
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LEFT
}

enum LeagueVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum LeagueStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

// ── Match enums ─────────────────────────────────────────────────────
enum MatchStatus {
  SCHEDULED
  LIVE
  HALF_TIME
  FULL_TIME
  POSTPONED
  CANCELLED
}

enum MatchStage {
  GROUP
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
  FRIENDLY
  OTHER
}

enum EventType {
  GOAL
  OWN_GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

enum PredictionType {
  OUTCOME
  DOUBLE_CHANCE
  CORRECT_SCORE
  TOTAL_GOALS
  BTTS
}

enum PredictionStatus {
  ACTIVE
  CLOSED
  GRADED
}

enum AIAnalysisType {
  PREVIEW
  POST_MATCH
  TOURNAMENT_SUMMARY
  GROUP_OUTLOOK
}

enum AIStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  STALE
  FAILED
}

enum AIJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ImportStatus {
  PENDING
  PREVIEWED
  COMMITTED
  FAILED
}

enum TransactionType {
  PREDICTION_STAKE
  PREDICTION_WIN
  MOCK_DEPOSIT
  ADMIN_ADJUST
  BONUS
  REFUND
  STARTER
}

enum CsvEntity {
  TEAMS
  PLAYERS
  FIXTURES
  SCORES
  GROUPS
}

// ── User (global) ───────────────────────────────────────────────────
model User {
  id                 String     @id @default(cuid())
  username           String
  normalizedUsername String     @unique
  phone              String
  normalizedPhone    String     @unique
  passwordHash       String
  birthYear          Int?
  role               Role       @default(FAN)
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions           Session[]
  predictions        Prediction[]
  auditLogs          AdminAuditLog[]  @relation("ActorAdmin")
  matchEvents        MatchEvent[]     @relation("EventCreator")
  playerImports      PlayerImport[]
  aiAnalysesReviewed AIAnalysis[]     @relation("AIReviewer")
  recoveryTokens     RecoveryToken[]
  leaguesCreated     League[]         @relation("LeagueCreator")
  memberships        LeagueMember[]
  wallet             Wallet?
  transactions       Transaction[]
  csvImports         CsvImport[]

  @@index([role])
  @@index([status])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RecoveryToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── League (tenant) ─────────────────────────────────────────────────
model League {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  logoUrl     String?
  country     String?
  region      String?
  visibility  LeagueVisibility @default(PUBLIC)
  status      LeagueStatus     @default(ACTIVE)
  inviteCode  String?          @unique
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User           @relation("LeagueCreator", fields: [createdById], references: [id])
  members    LeagueMember[]
  groups     Group[]
  teams      Team[]
  matches    Match[]
  settings   LeagueSetting[]
  csvImports CsvImport[]

  @@index([status])
  @@index([visibility])
  @@index([createdById])
}

model LeagueMember {
  id       String       @id @default(cuid())
  leagueId String
  userId   String
  role     LeagueRole   @default(FAN)
  status   MemberStatus @default(ACTIVE)
  joinedAt DateTime     @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId, role])
}

model LeagueSetting {
  id        String   @id @default(cuid())
  leagueId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, key])
}

// ── Competition structure (scoped to League) ────────────────────────
model Group {
  id           String   @id @default(cuid())
  leagueId     String
  code         String
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  league  League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams   Team[]
  matches Match[]

  @@unique([leagueId, code])
  @@index([leagueId])
}

model Team {
  id          String   @id @default(cuid())
  leagueId    String
  groupId     String?
  name        String
  slug        String
  shortName   String?
  color1      String   @default("#16a34a")
  color2      String   @default("#ffffff")
  color3      String   @default("#0f172a")
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league         League         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  group          Group?         @relation(fields: [groupId], references: [id])
  players        Player[]
  homeMatches    Match[]        @relation("HomeTeam")
  awayMatches    Match[]        @relation("AwayTeam")
  matchEvents    MatchEvent[]
  playerImports  PlayerImport[]

  @@unique([leagueId, slug])
  @@index([leagueId])
  @@index([groupId])
}

model Player {
  id             String    @id @default(cuid())
  teamId         String
  fullName       String
  normalizedName String
  position       String?
  age            Int?
  dateOfBirth    DateTime?
  phone          String?
  jerseyNumber   Int?
  nationality    String?
  status         String    @default("ACTIVE")
  adminNotes     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventsAsPlayer  MatchEvent[] @relation("EventPlayer")
  eventsAsRelated MatchEvent[] @relation("RelatedPlayer")

  @@unique([teamId, normalizedName])
  @@index([teamId])
  @@index([normalizedName])
}

model Match {
  id                 String      @id @default(cuid())
  leagueId           String
  stage              MatchStage  @default(GROUP)
  groupId            String?
  homeTeamId         String?
  awayTeamId         String?
  homeSlot           String?
  awaySlot           String?
  slotCode           String?
  kickoffAt          DateTime?
  venue              String?
  status             MatchStatus @default(SCHEDULED)
  halfTimeHomeScore  Int?
  halfTimeAwayScore  Int?
  fullTimeHomeScore  Int?
  fullTimeAwayScore  Int?
  published          Boolean     @default(true)
  notes              String?
  predictionCutoffAt DateTime?
  matchday           Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  group       Group?       @relation(fields: [groupId], references: [id])
  homeTeam    Team?        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team?        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  events      MatchEvent[]
  predictions Prediction[]
  aiAnalyses  AIAnalysis[]

  @@index([leagueId])
  @@index([status])
  @@index([stage])
  @@index([groupId])
  @@index([kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([leagueId, status])
  @@index([leagueId, matchday])
}

model MatchEvent {
  id               String    @id @default(cuid())
  matchId          String
  teamId           String?
  playerId         String?
  relatedPlayerId  String?
  eventType        EventType
  minute           Int?
  addedTime        Int?
  ownGoal          Boolean   @default(false)
  notes            String?
  createdByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  match          Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team           Team?   @relation(fields: [teamId], references: [id])
  player         Player? @relation("EventPlayer", fields: [playerId], references: [id])
  relatedPlayer  Player? @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])
  createdByAdmin User?   @relation("EventCreator", fields: [createdByAdminId], references: [id])

  @@index([matchId])
  @@index([playerId])
}

model Prediction {
  id              String           @id @default(cuid())
  userId          String
  matchId         String
  type            PredictionType
  selectedOutcome String?
  homeScore       Int?
  awayScore       Int?
  comment         String?
  status          PredictionStatus @default(ACTIVE)
  isCorrect       Boolean?
  pointsAwarded   Int?
  stakeAmount     Int              @default(0)
  potentialPayout Int?
  coinsAwarded    Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId, matchId, type])
  @@index([matchId])
  @@index([userId])
  @@index([status])
}

model AIAnalysis {
  id             String         @id @default(cuid())
  matchId        String?
  analysisType   AIAnalysisType
  model          String?
  promptVersion  String?
  sourceSnapshot String?
  content        String
  structured     String?
  status         AIStatus       @default(DRAFT)
  generatedAt    DateTime?
  reviewedById   String?
  publishedAt    DateTime?
  stale          Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  match      Match? @relation(fields: [matchId], references: [id])
  reviewedBy User?  @relation("AIReviewer", fields: [reviewedById], references: [id])

  @@index([matchId])
  @@index([status])
  @@index([analysisType])
}

model AIJob {
  id          String      @id @default(cuid())
  type        String
  payload     String
  status      AIJobStatus @default(QUEUED)
  attempts    Int         @default(0)
  availableAt DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())

  @@index([status, availableAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorAdminId String
  action       String
  targetType   String?
  targetId     String?
  metadata     String?
  createdAt    DateTime @default(now())

  actorAdmin User @relation("ActorAdmin", fields: [actorAdminId], references: [id])

  @@index([actorAdminId])
  @@index([createdAt])
}

model PlayerImport {
  id                String       @id @default(cuid())
  teamId            String
  uploadedByAdminId String
  filename          String
  totalRows         Int          @default(0)
  validRows         Int          @default(0)
  invalidRows       Int          @default(0)
  status            ImportStatus @default(PENDING)
  reportJson        String?
  createdAt         DateTime     @default(now())

  team            Team @relation(fields: [teamId], references: [id])
  uploadedByAdmin User @relation(fields: [uploadedByAdminId], references: [id])

  @@index([teamId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ── Phase 2: Virtual wallet + CSV imports ───────────────────────────
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Int
  type        TransactionType
  referenceId String?
  note        String?
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model CsvImport {
  id                String       @id @default(cuid())
  leagueId          String
  entity            CsvEntity
  uploadedByAdminId String
  filename          String
  totalRows         Int          @default(0)
  validRows         Int          @default(0)
  invalidRows       Int          @default(0)
  createdRows       Int          @default(0)
  updatedRows       Int          @default(0)
  skippedRows       Int          @default(0)
  status            ImportStatus @default(PENDING)
  reportJson        String?
  createdAt         DateTime     @default(now())

  league          League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  uploadedByAdmin User   @relation(fields: [uploadedByAdminId], references: [id])

  @@index([leagueId])
  @@index([entity])
  @@index([uploadedByAdminId])
}
